---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import { getCategoryGroups } from '@/lib/posts';

const groups = await getCategoryGroups();
---

<BaseLayout title="카테고리" description="주제별로 글을 모아봅니다.">
  <PageHeader title="카테고리" description="주제별로 글을 모아봅니다." />
  <ul class="category-index">
    {
      groups.map((group) => (
        <li class="category-index__item card">
          <CategoryBadge category={group.key} count={group.posts.length} />
          {group.description && <p>{group.description}</p>}
        </li>
      ))
    }
  </ul>
</BaseLayout>
